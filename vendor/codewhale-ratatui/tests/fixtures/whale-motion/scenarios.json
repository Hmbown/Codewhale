    {
      "id": "first-output",
      "label": "First output pending",
      "steps": [
        {
          "presence": "Thinking",
          "expected": "think"
        }
      ]
    },
    {
      "id": "reasoning",
      "label": "Reasoning stream",
      "steps": [
        {
          "presence": "Working",
