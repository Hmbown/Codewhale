            "observed": true
          },
          "expected": "think"
        }
      ]
    },
    {
      "id": "tool-gap",
      "label": "Between tool steps",
      "steps": [
        {
          "presence": "Working",
          "activity": {
            "kind": "reading",
            "observed": true
          },
          "expected": "read"
        },
        {
          "after": 24,
          "presence": "Working",
          "activity": {
            "kind": "unknown",
            "observed": false
          },
          "expected": "busy"
        }
      ]
    },
    {
      "id": "desktop-browser",
      "label": "Desktop → browser",
      "steps": [
        {
          "presence": "Working",
          "activity": {
            "kind": "computer",
            "observed": true
          },
          "expected": "computer"
        },
        {
          "after": 45,
          "presence": "Working",
          "activity": {
            "kind": "browsing",
            "observed": true
          },
          "expected": "browse"
        }
      ]
    },
    {
      "id": "service-call",
      "label": "Connected app request",
      "steps": [
        {
          "presence": "Working",
          "activity": {
            "kind": "network",
