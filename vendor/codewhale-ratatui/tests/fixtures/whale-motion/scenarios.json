      "steps": [
        {
          "presence": "Working",
          "activity": {
            "kind": "computer",
            "observed": true
          },
          "expected": "computer"
        },
        {
          "after": 20,
          "presence": "NeedsYou",
          "expected": "needs"
        },
        {
          "after": 50,
          "presence": "Working",
          "activity": {
            "kind": "computer",
            "observed": true
          },
          "expected": "computer"
        }
      ]
    },
    {
      "id": "user-input",
      "label": "Question or sign-in needs you",
      "steps": [
        {
          "presence": "NeedsYou",
          "expected": "needs"
        }
      ]
    },
    {
      "id": "permission-denied",
      "label": "Permission declined, turn canceled",
      "steps": [
        {
          "presence": "NeedsYou",
          "expected": "needs"
        },
        {
          "after": 30,
          "presence": "Idle",
          "context": {
            "status": "canceled"
          },
          "expected": "rest"
        }
      ]
    },
    {
      "id": "interrupted",
      "label": "User interrupts work",
      "steps": [
        {
          "presence": "Working",
          "activity": {
            "kind": "executing",
            "observed": true
          },
          "expected": "run"
        },
        {
          "after": 30,
          "presence": "Idle",
          "context": {
            "status": "interrupted"
          },
          "expected": "rest"
        }
      ]
    },
    {
      "id": "cancel-not-failure",
      "label": "Cancellation is not Stuck",
      "steps": [
        {
          "presence": "Stuck",
          "context": {
            "status": "canceled"
          },
          "expected": "rest"
        }
      ]
    },
    {
      "id": "failed-turn",
      "label": "Genuine failed turn · proposed",
      "steps": [
        {
          "presence": "Stuck",
          "context": {
            "status": "failed",
            "nowMs": 500,
            "failedAtMs": 0
          },
          "expected": "hmm"
        }
      ]
    },
    {
      "id": "failure-expires",
      "label": "Failure cue expires",
      "steps": [
        {
          "presence": "Stuck",
          "context": {
            "status": "failed",
            "nowMs": 3000,
            "failedAtMs": 0
          },
          "expected": "rest"
        }
      ]
    },
    {
      "id": "retry",
      "label": "Failed tool → retry",
      "steps": [
        {
          "presence": "Working",
          "activity": {
            "kind": "executing",
            "observed": true
          },
          "expected": "run"
        },
        {
          "after": 40,
          "event": {
            "type": "failed",
            "kind": "executing",
            "status": "failed"
          },
          "expected": "run"
        },
        {
          "after": 12,
          "presence": "Working",
          "activity": {
            "kind": "executing",
            "observed": true,
            "active": [
              {
                "kind": "executing",
                "sinceMs": 2000
              }
            ]
          },
          "expected": "run"
        }
      ]
    },
    {
      "id": "completion",
      "label": "Completed turn",
      "steps": [
        {
          "presence": "Working",
          "activity": {
            "kind": "responding",
            "observed": true
          },
          "expected": "talk"
        },
        {
          "after": 35,
          "presence": "Done",
          "expected": "done"
        },
        {
          "after": 80,
          "presence": "Idle",
          "expected": "rest"
        }
      ]
    },
    {
      "id": "completion-once",
      "label": "Listening interrupts Done",
      "steps": [
        {
          "presence": "Done",
          "expected": "done"
        },
        {
          "after": 30,
          "presence": "Listening",
          "expected": "listen"
        },
        {
          "after": 20,
          "presence": "Done",
          "expected": "done"
        }
      ],
      "spouts": 1
    },
    {
      "id": "completion-no-id",
      "label": "No completion ID, no flourish",
      "steps": [
        {
          "presence": "Done",
          "context": {
            "turnId": null
          },
          "expected": "done"
        },
        {
          "after": 80,
          "presence": "Done",
          "context": {
            "turnId": null
          },
          "expected": "done"
        }
      ],
      "spouts": 0
    },
    {
      "id": "disconnect",
      "label": "Connection lost during work",
      "steps": [
        {
          "presence": "Working",
          "activity": {
            "kind": "editing",
            "observed": true
          },
          "expected": "write"
        },
        {
          "after": 24,
          "presence": "Offline",
          "expected": "sleep"
        }
      ]
    },
    {
      "id": "reconnect",
      "label": "Reconnect and resume",
      "steps": [
        {
          "presence": "Offline",
          "expected": "sleep"
        },
        {
          "after": 90,
          "presence": "Working",
          "activity": {
            "kind": "reading",
            "observed": true
          },
          "expected": "read"
        }
      ]
    },
    {
      "id": "computer-sleep",
      "label": "Computer sleeping, Engine still ready",
      "steps": [
        {
          "presence": "Idle",
          "expected": "rest"
        }
      ]
    },
