      "result": {
        "protocolVersion": "2025-06-18",
        "serverInfo": {
          "name": "catalog-fixture",
          "version": "1.0.0"
        },
        "capabilities": {
          "tools": {}
        }
      }
    },
    "tools/list": {
      "result": {
        "tools": [
          {
            "name": "plain",
            "inputSchema": {
              "type": "object"
            }
          },
          {
            "name": "reader",
            "inputSchema": {
              "type": "object"
            },
            "annotations": {
              "readOnlyHint": true
            }
          },
          {
            "name": "deleter",
            "inputSchema": {
              "type": "object"
            },
            "annotations": {
              "destructiveHint": true
            }
          },
          {
            "name": "confused",
            "inputSchema": {
              "type": "object"
            },
            "annotations": {
              "readOnlyHint": true,
              "destructiveHint": true
            }
          },
          {
            "name": "gentle_writer",
            "inputSchema": {
              "type": "object"
            },
            "annotations": {
              "destructiveHint": false
            }
          }
        ]
      }
    }
  },
  "steps": [
