{
  "$schema": "https://agent-plugins.org/schemas/plugin.json",
  "name": "computer-use",
  "version": "0.3.0",
  "description": "Let Codewhale see and operate your apps.",
  "author": {
    "name": "Codewhale"
  },
  "license": "MIT",
  "keywords": [
    "computer-use",
    "automation",
    "screenshot",
    "recording",
    "accessibility",
    "harmonyos"
  ],
  "extensions": {
    "net.codewhale": {
      "display_name": "Computer Use",
      "commands": {
        "path": "commands"
      },
      "skills": {
        "path": "skills"
      },
      "when": {
        "binaries": [
          "node"
        ],
        "os": [
          "macos",
          "linux",
          "windows"
        ]
      },
      "icon": "data:image/png;base64,"
    }
  },
  "homepage": "https://codewhale.net/computer-use",
  "repository": "https://github.com/Hmbown/codewhale-cu-plugin"
}
