{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:whalesong:evidence:v1",
  "title": "Whalesong boundary evidence v1",
  "description": "Metadata contract; validation is not source authentication. Runtime also enforces unique source/grant IDs, producer sequences and expiry ordering.",
  "type": "object",
  "properties": {
    "format": {
      "const": "whalesong.evidence/v1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "records": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "asOf": {
      "type": "number",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "format",
    "name",
    "records",
    "policy",
    "asOf"
  ],
  "additionalProperties": false,
  "$defs": {
    "observation": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "epoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "time": {
          "type": "object",
          "properties": {
            "wallMs": {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "clockId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "monotonicMs": {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "taskMs": {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "uncertaintyMs": {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "wallMs"
          ],
          "additionalProperties": false
        },
        "receivedAt": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "subject": {
          "type": "object",
          "properties": {
            "agentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "sandboxId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "isolationGroup": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          },
          "required": [
            "agentId"
          ],
          "additionalProperties": false
        },
        "stage": {
          "enum": [
            "intent",
            "dispatch",
            "runtime",
            "effect",
            "control"
          ]
        },
        "surface": {
          "enum": [
            "model-api",
            "http",
            "mcp",
            "git",
            "filesystem",
            "process",
            "sandbox",
            "dns",
            "socket",
            "message",
            "database",
            "artifact",
            "browser",
            "clipboard",
            "other"
          ]
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "effect": {
          "enum": [
            "read",
            "write",
            "delete",
            "execute",
            "publish",
            "send",
            "receive",
            "connect",
            "grant",
            "revoke",
            "none",
            "unknown"
          ]
        },
        "status": {
          "enum": [
            "started",
            "completed",
            "error",
            "unknown"
          ]
        },
        "target": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "boundary": {
              "enum": [
                "local",
                "external",
                "unknown"
              ]
            }
          },
          "required": [
            "id",
            "kind"
          ],
          "additionalProperties": false
        },
        "actionDigest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "authority": {
          "type": "object",
          "properties": {
            "grantId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "claimed": {
              "type": "boolean"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "correlation": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "parentOperationId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            },
            "messageId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "facts": {
          "type": "object",
          "maxProperties": 48,
          "propertyNames": {
            "allOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              {
                "not": {
                  "enum": [
                    "__proto__",
                    "prototype",
                    "constructor"
                  ]
                }
              }
            ]
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              {
                "type": "number",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            ]
          }
        }
      },
      "required": [
        "version",
        "id",
        "runId",
        "sourceId",
        "epoch",
        "sequence",
        "time",
        "subject",
        "stage",
        "surface",
        "action",
        "effect",
        "status"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "stages": {
          "type": "array",
          "items": {
            "enum": [
              "intent",
              "dispatch",
              "runtime",
              "effect",
              "control"
            ]
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "surfaces": {
          "type": "array",
          "items": {
            "enum": [
              "model-api",
              "http",
              "mcp",
              "git",
              "filesystem",
              "process",
              "sandbox",
              "dns",
              "socket",
              "message",
              "database",
              "artifact",
              "browser",
              "clipboard",
              "other"
            ]
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "runIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "sandboxIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "isolationGroups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "heartbeatMs": {
          "type": "number",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      },
      "required": [
        "id",
        "stages",
        "surfaces",
        "runIds",
        "heartbeatMs"
      ],
      "additionalProperties": false
    },
    "grant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "runIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "sandboxIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "targetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "effects": {
          "type": "array",
          "items": {
            "enum": [
              "read",
              "write",
              "delete",
              "execute",
              "publish",
              "send",
              "receive",
              "connect",
              "grant",
              "revoke",
              "none",
              "unknown"
            ]
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "notBefore": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expiresAt": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "actionDigest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      },
      "required": [
        "id",
        "runIds",
        "sandboxIds",
        "targetIds",
        "actions",
        "effects",
        "notBefore",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grant"
          },
          "minItems": 0,
          "maxItems": 2048,
          "uniqueItems": true
        },
        "expectedSurfaces": {
          "type": "array",
          "items": {
            "enum": [
              "model-api",
              "http",
              "mcp",
              "git",
              "filesystem",
              "process",
              "sandbox",
              "dns",
              "socket",
              "message",
              "database",
              "artifact",
              "browser",
              "clipboard",
              "other"
            ]
          },
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true
        },
        "forbiddenCrossGroup": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "id",
        "sources",
        "grants",
        "expectedSurfaces",
        "forbiddenCrossGroup"
      ],
      "additionalProperties": false
    }
  }
}
